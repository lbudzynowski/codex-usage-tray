#!/usr/bin/make -f

export PYBUILD_NAME = codex-usage-tray

%:
	dh $@ --with python3

override_dh_auto_build:
	:

override_dh_auto_clean:
	:

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src python3 -m unittest discover -s tests -v
	python3 -c 'import ast, pathlib; [ast.parse(path.read_text(encoding="utf-8"), filename=str(path), feature_version=(3, 11)) for path in pathlib.Path("src").rglob("*.py")]'
	desktop-file-validate packaging/debian/codex-usage-tray.desktop packaging/debian/codex-usage-tray-autostart.desktop
endif

override_dh_auto_install:
	install -d debian/codex-usage-tray/usr/lib/python3/dist-packages/codex_usage_tray
	install -m 0644 src/codex_usage_tray/*.py debian/codex-usage-tray/usr/lib/python3/dist-packages/codex_usage_tray/
	install -D -m 0755 packaging/debian/codex-usage-tray debian/codex-usage-tray/usr/bin/codex-usage-tray
	install -D -m 0644 packaging/debian/codex-usage-tray.desktop debian/codex-usage-tray/usr/share/applications/codex-usage-tray.desktop
	install -D -m 0644 packaging/debian/codex-usage-tray-autostart.desktop debian/codex-usage-tray/etc/xdg/autostart/codex-usage-tray.desktop
